<Window x:Class="PinHoard.view.menus.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinHoard.view.menus"
        mc:Ignorable="d"
        Title="PreferencesWindow" Height="400" Width="600"
        ResizeMode="NoResize">
    <StackPanel>
        <Label Content="User Preferences" FontSize="20" HorizontalAlignment="Left" Margin="20,20"/>
        <StackPanel Margin="20,0" MinHeight="200">
            <DockPanel LastChildFill="False">
                <Label Content="Theme:" DockPanel.Dock="Left"/>
                <ComboBox x:Name="ThemeSelector" Width="250" DockPanel.Dock="Right"/>
            </DockPanel>
            <DockPanel Margin="0,5" LastChildFill="False">
                <Label Content="Window Style:" DockPanel.Dock="Left"/>
                <ComboBox x:Name="WindowModeSelector" Width="250" DockPanel.Dock="Right"/>
            </DockPanel>
            <DockPanel Margin="0,5" LastChildFill="False">
                <Label Content="Default Board Window Size:" DockPanel.Dock="Left"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Label Content="x:"/>
                    <TextBox x:Name="DefaultWidthBox" Width="100" Margin="5,0"/>
                    <Label Content="y:"/>
                    <TextBox x:Name="DefaultHeightBox" Width="100" Margin="5,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <Button Content="Save &amp; Close" Width="150" HorizontalAlignment="Right" Margin="20" Click="Save_Click"/>
    </StackPanel>
</Window>
